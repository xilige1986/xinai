// ==================== 多级推广奖励系统 ====================

// 多级推广记录模型 - 记录每一级的推广奖励
model MultiLevelReferralRecord {
  id           Int      @id @default(autoincrement())

  // 注册的新用户
  newUserId    Int
  newUser      User     @relation(fields: [newUserId], references: [id], onDelete: Cascade)

  // 获得奖励的用户（可能是1级、2级、3级推荐人）
  earnerId     Int
  earner       User     @relation("EarnerRecords", fields: [earnerId], references: [id], onDelete: Cascade)

  // 推广层级: 1=直接推荐, 2=间接推荐(2级), 3=间接推荐(3级)
  level        Int

  // 奖励积分
  points       Int

  // 该用户当时的会员等级
  membershipAtReward String @default("MEMBER")

  // 状态
  status       Int      @default(1) // 1:有效, 0:无效

  createdAt    DateTime @default(now())

  @@index([newUserId])
  @@index([earnerId])
  @@index([level])
  @@index([createdAt])
}

