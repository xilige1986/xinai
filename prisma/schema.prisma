datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "windows"]
}

// ============================================
// 1. AI工具主分类（一级分类）
// ============================================
model Category {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(50)
  slug        String        @unique @db.VarChar(50)
  description String?       @db.Text
  icon        String?       @db.VarChar(100)
  sortOrder   Int           @default(0)

  subCategories SubCategory[]
  tools         Tool[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([sortOrder])
}

// ============================================
// 2. AI工具二级分类
// ============================================
model SubCategory {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(50)
  slug        String    @db.VarChar(50)
  description String?   @db.Text

  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  tools       Tool[]

  createdAt   DateTime  @default(now())

  @@unique([categoryId, slug])
  @@index([categoryId])
}

// ============================================
// 3. 使用场景
// ============================================
model UseCase {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(50)
  slug         String   @unique @db.VarChar(50)
  description  String?  @db.Text
  adoptionRate Float    @default(0.0)

  tools        Tool[]

  createdAt    DateTime @default(now())
}

// ============================================
// 4. AI 工具模型（MySQL 优化版）
// ============================================
model Tool {
  id            Int          @id @default(autoincrement())
  name          String       @unique @db.VarChar(100)
  slug          String       @unique @db.VarChar(100)
  shortDesc     String       @db.VarChar(200)
  description   String       @db.LongText
  websiteUrl    String       @db.VarChar(500)
  imageUrl      String?      @db.VarChar(200)
  pricingType   String       @default("Free") @db.VarChar(20)
  status        Int          @default(0) // 0:待审, 1:发布, 2:拒绝

  categoryId    Int
  category      Category     @relation(fields: [categoryId], references: [id])
  subCategoryId Int?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])
  useCaseId     Int
  useCase       UseCase      @relation(fields: [useCaseId], references: [id])

  courses       Course[]     @relation("ToolToCourse")
  favoritedBy   User[]       @relation("UserFavorites")
  reviews       Review[]
  aiContent     ToolAIContent?

  views         Int          @default(0)
  likes         Int          @default(0)
  ratingSum     Int          @default(0)
  ratingCount   Int          @default(0)

  sortOrder     Int          @default(0)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([useCaseId])
  @@index([status])
  @@index([status, categoryId, sortOrder])      // 分类列表查询
  @@index([status, views, sortOrder])           // 热门排序
  @@index([pricingType])
  @@index([slug])
  @@index([status, likes, sortOrder])           // 点赞排序
  @@index([status, createdAt, sortOrder])       // 最新排序
  @@fulltext([name, shortDesc])                 // 工具搜索全文索引，减轻 LIKE 全表扫描
}

// ============================================
// 5. 商业化课程模型（金额用 Int 存分）
// ============================================
model Course {
  id                Int      @id @default(autoincrement())
  title             String   @db.VarChar(200)
  slug              String   @unique @db.VarChar(100)
  description       String   @db.Text
  coverImage        String?  @db.VarChar(200)
  price             Int      @default(0)         // 单位：分
  originalPrice     Int      @default(0)         // 单位：分
  buyUrl            String   @db.VarChar(500)
  level             String   @default("Beginner") @db.VarChar(20)
  studentCount      Int      @default(0)

  duration          String   @default("6.5") @db.VarChar(10)
  lessonCount       Int      @default(12)
  targetAudience    String?  @db.Text
  whatYouWillLearn  Json?    // MySQL JSON 类型
  outline           Json?

  instructorName    String   @default("AI工具库专家团队") @db.VarChar(50)
  instructorAvatar  String?  @db.VarChar(200)
  instructorBio     String?  @db.Text

  includes          Json?    // MySQL JSON 类型

  promoVideoUrl     String?  @db.VarChar(500)   // 课程宣传视频URL
  promoVideoPlatform String? @db.VarChar(20)   // 视频平台：youtube, bilibili, local

  allowMoneyPurchase   Boolean @default(true)
  allowPointsPurchase  Boolean @default(false)
  pointsRequired       Int     @default(0)

  tools        Tool[]   @relation("ToolToCourse")
  chapters     Chapter[]
  orders       Order[]
  pointsAccess CoursePointsAccess[]

  status       Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([slug])
  @@index([status, studentCount])               // 按学习人数排序
}

// ============================================
// 6. 课程积分解锁记录
// ============================================
model CoursePointsAccess {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  points    Int      // 消耗的积分
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

// ============================================
// 7. 用户模型（membership 改为 Int）
// ============================================
model User {
  id                Int      @id @default(autoincrement())
  username          String   @unique @db.VarChar(30)
  email             String   @unique @db.VarChar(100)
  phone             String?  @unique @db.VarChar(20)
  password          String   @db.VarChar(255)   // bcrypt 哈希
  name              String?  @db.VarChar(50)
  avatar            String?  @db.VarChar(200)
  role              String   @default("USER") @db.VarChar(20)
  membership        Int      @default(1)        // 1=MEMBER, 2=VIP, 3=FOUNDER
  status            Int      @default(1)        // 0=禁用, 1=正常
  emailVerified     DateTime?

  favorites         Tool[]   @relation("UserFavorites")
  reviews           Review[]
  comments          Comment[]
  lessonProgresses  LessonProgress[]
  orders            Order[]
  coursePointsAccess CoursePointsAccess[]
  founderEarnings   FounderEarning[]
  founderContributions FounderContribution[]

  referralCode      String?  @unique @db.VarChar(20)
  referredBy        Int?
  referrer          User?    @relation("UserReferrals", fields: [referredBy], references: [id])
  referrals         User[]   @relation("UserReferrals")

  referralCount     Int      @default(0)
  points            Int      @default(0)

  referralRecords   ReferralRecord[]
  referredRecords   ReferralRecord[] @relation("ReferredRecords")
  multiLevelReferralRecords MultiLevelReferralRecord[]
  earnerRecords     MultiLevelReferralRecord[] @relation("EarnerRecords")
  pointsLogs        PointsLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referralCode])
  @@index([referredBy])
  @@index([membership])
  @@index([status])
  @@index([points])
  @@index([referralCount])
}

// ============================================
// 8. 创始股东收益（金额用 Int 存分）
// ============================================
model FounderEarning {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int      // 单位：分
  type        String   @db.VarChar(50)
  description String   @db.Text
  orderId     Int?
  status      Int      @default(0) // 0:待结算, 1:已结算
  createdAt   DateTime @default(now())
  settledAt   DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// 9. 创始股东贡献记录
// ============================================
model FounderContribution {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @db.VarChar(50)
  title       String   @db.VarChar(200)
  description String   @db.Text
  status      Int      @default(0) // 0:待审核, 1:已通过, 2:已拒绝
  points      Int      @default(0)
  newsId      Int?
  toolId      Int?
  reviewId    Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
}

// ============================================
// 10. 首页快捷入口
// ============================================
model QuickLink {
  id        Int      @id @default(autoincrement())
  label     String   @db.VarChar(50)
  href      String   @db.VarChar(500)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

// ============================================
// 11. 工具评分和点评
// ============================================
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // 评分 1-5
  content   String   @db.Text
  toolId    Int
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    Int      @default(0) // 0=待审核, 1=已通过, 2=已拒绝
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([toolId, userId])
  @@index([toolId])
  @@index([userId])
  @@index([status])
  @@index([toolId, status])                     // 工具点评列表
}

// ============================================
// 12. 网站设置
// ============================================
model SiteSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(50)
  value       String   @db.Text
  description String?  @db.VarChar(200)
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ============================================
// 13. 资讯文章（JSON + 全文索引）
// ============================================
model News {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(100)
  summary     String?  @db.VarChar(500)
  content     String?  @db.LongText          // 改为可选：聚合新闻不存正文，原创新闻存正文
  coverImage  String?  @db.VarChar(200)
  author      String   @default("编辑团队") @db.VarChar(50)
  source      String?  @db.VarChar(100)      // 聚合来源名称（如：机器之心）
  sourceUrl   String?  @db.VarChar(500)      // 聚合来源URL（存在则跳转到外部）
  isAggregated Boolean @default(false)       // 是否聚合新闻

  category    String   @default("AI资讯") @db.VarChar(50)
  tags        Json?    // MySQL JSON 类型

  views       Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)

  status      Int      @default(0) // 0=草稿, 1=已发布, 2=置顶
  isHot       Boolean  @default(false)

  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  commentList Comment[]

  @@index([status])
  @@index([publishedAt])
  @@index([category])
  @@index([isHot])
  @@index([isAggregated])
  @@index([status, publishedAt, isHot])         // 首页资讯列表
  @@fulltext([title, content])                  // MySQL 全文搜索
  @@fulltext([title])                           // 标题搜索
}

// ============================================
// 13.1 新闻源配置（支持RSS和API）
// ============================================
model NewsSource {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)           // 源站名称，如：机器之心
  type          String   @db.VarChar(20)            // rss | api | manual
  category      String   @default("AI资讯") @db.VarChar(50)  // 分类

  // RSS 配置
  rssUrl        String?  @db.VarChar(500)           // RSS订阅地址

  // API 配置
  apiUrl        String?  @db.VarChar(500)           // API端点
  apiKey        String?  @db.VarChar(200)           // API密钥
  apiParams     Json?                                // 额外参数 {q: 'AI', language: 'zh'}

  // 通用配置
  fetchInterval Int      @default(60)               // 抓取间隔（分钟）
  isActive      Boolean  @default(true)             // 是否启用
  lastFetchedAt DateTime?                           // 上次抓取时间

  // 字段映射（用于RSS/API字段映射）
  fieldMapping  Json?                                // {title: 'title', link: 'link', pubDate: 'pubDate'}

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([lastFetchedAt])
}

// ============================================
// 13.2 新闻抓取日志
// ============================================
model NewsCrawlLog {
  id            Int      @id @default(autoincrement())
  sourceId      Int
  sourceType    String   @db.VarChar(20)            // rss | api
  status        String   @db.VarChar(20)            // success | error | partial
  message       String?  @db.Text                    // 日志信息
  fetchedCount  Int      @default(0)                // 本次抓取数量
  errorMessage  String?  @db.Text                    // 错误详情
  createdAt     DateTime @default(now())

  @@index([sourceId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// 14. 资讯评论
// ============================================
model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  newsId    Int
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    Int      @default(0) // 0=待审核, 1=已通过, 2=已拒绝
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([newsId])
  @@index([userId])
  @@index([status])
  @@index([newsId, status, createdAt])          // 资讯评论列表
}

// ============================================
// 15. 邮件订阅
// ============================================
model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(100)
  name      String?  @db.VarChar(50)
  status    Int      @default(1) // 0=取消订阅, 1=已订阅
  source    String   @default("news_page") @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([source])
}

// ============================================
// 16. 自动推送配置
// ============================================
model NewsletterSchedule {
  id                Int      @id @default(autoincrement())
  name              String   @default("定时推送") @db.VarChar(50)
  enabled           Boolean  @default(false)
  frequency         String   @default("weekly") @db.VarChar(20)
  dayOfWeek         Int?
  dayOfMonth        Int?
  time              String   @default("09:00") @db.VarChar(5)
  subject           String   @default("AI资讯精选") @db.VarChar(100)
  content           String?  @db.Text
  autoSelectNews    Boolean  @default(true)
  maxNewsCount      Int      @default(5)
  lastSentAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  history           NewsletterHistory[]

  @@index([enabled])
  @@index([frequency])
}

// ============================================
// 17. 推送历史记录
// ============================================
model NewsletterHistory {
  id                Int      @id @default(autoincrement())
  scheduleId        Int
  schedule          NewsletterSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  subject           String   @db.VarChar(200)
  content           String?  @db.Text
  sentCount         Int      @default(0)
  failedCount       Int      @default(0)
  totalSubscribers  Int      @default(0)
  newsIds           String   @db.Text         // JSON 数组
  status            String   @default("sending") @db.VarChar(20)
  errorMessage      String?  @db.Text
  createdAt         DateTime @default(now())

  @@index([scheduleId])
  @@index([createdAt])
  @@index([status])
}

// ============================================
// 18. 课程章节
// ============================================
model Chapter {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(100)
  description String?   @db.Text
  sortOrder   Int       @default(0)

  courseId    Int
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons     Lesson[]

  status      Int       @default(1) // 0=隐藏, 1=显示
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([courseId])
  @@index([sortOrder])
  @@index([courseId, sortOrder])
}

// ============================================
// 19. 课时模型
// ============================================
model Lesson {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(100)
  description String?   @db.Text
  duration    Int       @default(0) // 预计学习时长（分钟）
  sortOrder   Int       @default(0)

  contentType String    @default("text") @db.VarChar(20) // video | text

  videoUrl    String?   @db.VarChar(500)
  videoPlatform String? @db.VarChar(20)

  textContent String?   @db.LongText
  markdownContent String? @db.LongText

  isFree      Boolean   @default(false)

  chapterId   Int
  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  courseId    Int

  progresses  LessonProgress[]

  status      Int       @default(1) // 0=草稿, 1=已发布
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([chapterId])
  @@index([courseId])
  @@index([sortOrder])
  @@index([isFree])
  @@index([chapterId, sortOrder])
}

// ============================================
// 20. 学习进度
// ============================================
model LessonProgress {
  id          Int       @id @default(autoincrement())

  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId    Int
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  courseId    Int

  progress    Int       @default(0) // 学习进度百分比 0-100
  isCompleted Boolean   @default(false)
  lastPosition Int?     // 视频：上次观看位置（秒）；文字：阅读位置

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([courseId])
  @@index([isCompleted])
  @@index([userId, courseId])                   // 用户课程进度
}

// ============================================
// 21. 订单模型（金额用 Int 存分）
// ============================================
model Order {
  id        Int      @id @default(autoincrement())
  orderNo   String   @unique @db.VarChar(32)
  userId    Int
  courseId  Int
  amount    Int      // 单位：分
  status    Int      @default(0) // 0:待支付 1:已支付 2:已取消 3:已退款
  payType   String?  @db.VarChar(20)
  payTime   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([courseId])
  @@index([userId, courseId])
  @@index([orderNo])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])                     // 用户订单列表
}

// ============================================
// 22. 推广记录
// ============================================
model ReferralRecord {
  id          Int       @id @default(autoincrement())

  referrerId  Int
  referrer    User      @relation(fields: [referrerId], references: [id])

  referredId  Int
  referred    User      @relation("ReferredRecords", fields: [referredId], references: [id])

  points      Int

  status      Int       @default(1) // 1:有效, 0:无效

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([referrerId])
  @@index([referredId])
  @@index([status])
}

// ============================================
// 23. 多级推广记录
// ============================================
model MultiLevelReferralRecord {
  id           Int      @id @default(autoincrement())

  newUserId    Int
  newUser      User     @relation(fields: [newUserId], references: [id], onDelete: Cascade)

  earnerId     Int
  earner       User     @relation("EarnerRecords", fields: [earnerId], references: [id], onDelete: Cascade)

  level        Int      // 1=直接推荐, 2=2级, 3=3级

  points       Int

  membershipAtReward String @default("MEMBER") @db.VarChar(20)

  status       Int      @default(1) // 1:有效, 0:无效

  createdAt    DateTime @default(now())

  @@index([newUserId])
  @@index([earnerId])
  @@index([level])
  @@index([createdAt])
  @@index([earnerId, createdAt])                // 推广人收益查询
}

// ============================================
// 24. 积分记录
// ============================================
model PointsLog {
  id          Int       @id @default(autoincrement())

  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  points      Int       // 正数增加，负数减少
  type        String    @db.VarChar(50)
  description String?   @db.Text
  relatedId   Int?
  operatorId  Int?

  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([userId, createdAt])                  // 用户积分明细
}

// ============================================
// 25. 验证码模型
// ============================================
model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String?  @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  code      String   @db.VarChar(10)
  type      String   @db.VarChar(20)
  purpose   String   @default("register") @db.VarChar(20)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([phone])
  @@index([code])
  @@index([expiresAt])
  @@index([used])
  @@index([email, type, purpose])
  @@index([phone, type, purpose])
}

// ============================================
// 26. AI工具生成的内容介绍
// ============================================
model ToolAIContent {
  id                Int       @id @default(autoincrement())
  toolId            Int       @unique
  tool              Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)

  content           String    @db.LongText    // AI生成的完整介绍
  summary           String?   @db.VarChar(500) // 摘要，用于SEO或列表展示

  // 生成元数据
  modelName         String    @default("deepseek-chat") @db.VarChar(50)
  modelVersion      String?   @db.VarChar(30)
  promptTokens      Int?
  completionTokens  Int?
  cost              Float?                    // 成本（人民币元）

  // 版本控制
  version           Int       @default(1)
  isActive          Boolean   @default(true)

  // 生成方式：system=系统自动生成, manual=管理员手动触发
  generatedBy       String    @default("system") @db.VarChar(20)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([toolId])
  @@index([isActive])
  @@index([modelName])
}

// ============================================
// 27. 部署指纹追踪（开源项目统计使用）
// ============================================
model DeploymentFingerprint {
  id                Int       @id @default(autoincrement())
  fingerprint       String    @unique @db.VarChar(64)     // 部署实例唯一指纹
  domain            String?   @db.VarChar(200)             // 部署域名
  firstSeenAt       DateTime  @default(now())              // 首次上报时间
  lastSeenAt        DateTime  @updatedAt                   // 最后上报时间
  reportCount       Int       @default(1)                  // 上报次数
  version           String    @db.VarChar(30)              // 项目版本
  isActive          Boolean   @default(true)               // 是否活跃

  @@index([fingerprint])
  @@index([lastSeenAt])
  @@index([isActive])
}
