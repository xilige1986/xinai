# 数据库配置 (MySQL)
DATABASE_URL="mysql://username:password@localhost:3306/ai_tools_platform"

# NextAuth 配置
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# 生产环境 CORS 白名单：填写允许的前端域名（如 https://www.yourdomain.com），不设则开发用 *，生产建议必设
# ALLOWED_ORIGINS="https://www.yourdomain.com"

# 可选：邮件配置（用于通知）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# OpenAI API Key (用于AI自动分类)
# 申请地址: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# 可选: 如果使用其他AI服务
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Resend 邮件服务配置（用于发送验证码）
# 申请地址: https://resend.com
RESEND_API_KEY="re_..."
FROM_EMAIL="noreply@yourdomain.com"

# 阿里云短信服务配置（可选，用于发送手机验证码）
# SMS_ACCESS_KEY_ID="your-access-key-id"
# SMS_ACCESS_KEY_SECRET="your-access-key-secret"
# SMS_SIGN_NAME="你的签名"
# SMS_TEMPLATE_CODE="SMS_12345678"

# 部署追踪配置（可选，默认启用）
# 设置 DISABLE_TRACKING=true 可禁用部署统计追踪
# DISABLE_TRACKING=false

# 新闻抓取配置（可选）
# 开发模式下设置 ENABLE_NEWS_CRAWL=true 启用自动新闻抓取
# ENABLE_NEWS_CRAWL=false
