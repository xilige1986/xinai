# 支付配置示例文件
# 复制此文件为 .env.local 并填入真实配置

# ========== 微信支付配置 ==========
# 商户号
WECHAT_PAY_MCH_ID=your_mch_id
# APIv3密钥
WECHAT_PAY_API_KEY=your_apiv3_key
# 公众号AppID
WECHAT_PAY_APP_ID=your_wechat_app_id
# 证书路径 (相对于项目根目录或绝对路径)
WECHAT_PAY_CERT_PATH=./certs/apiclient_cert.pem
WECHAT_PAY_KEY_PATH=./certs/apiclient_key.pem
# 是否沙箱环境 (开发测试用)
WECHAT_PAY_SANDBOX=false

# ========== 支付宝配置 ==========
# 应用ID
ALIPAY_APP_ID=your_alipay_app_id
# 应用私钥 (单行字符串，去掉换行)
ALIPAY_PRIVATE_KEY=your_private_key
# 支付宝公钥
ALIPAY_PUBLIC_KEY=alipay_public_key
# 网关地址 (沙箱: https://openapi.alipaydev.com/gateway.do)
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
# 是否沙箱环境
ALIPAY_SANDBOX=false
# 回调地址
ALIPAY_NOTIFY_URL=https://your-domain.com/api/pay/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/pay/success

# ========== 通用配置 ==========
# 支付结果通知地址
PAY_NOTIFY_URL=https://your-domain.com/api/pay/notify
# 前端支付成功回调页
PAY_SUCCESS_URL=https://your-domain.com/pay/success
